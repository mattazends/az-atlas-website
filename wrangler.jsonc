{
  "name": "az-atlas-website",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LEAD_TO": "mattshahriyari@gmail.com"
  },
  "observability": { "enabled": true }
}
